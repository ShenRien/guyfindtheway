{
  "name": "nulite-starter",
  "version": "1.0.0",
  "description": "A minimal, elegant starter project to create a simple blog with Eleventy",
  "main": "index.js",
  "scripts": {
    "build": "npx @11ty/eleventy",
    "start": "npx @11ty/eleventy --serve --quiet",
    "dev": "eleventy --serve --watch",
    "debug": "DEBUG=Eleventy* npx @11ty/eleventy",
    "debugstart": "DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
    "benchmark": "DEBUG=Eleventy:Benchmark* npx @11ty/eleventy"
  },
  "keywords": [
    "eleventy",
    "starter"
  ],
  "author": "Diego López",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "eleventy-plugin-code-style-hooks": "^2.0.2",
    "eleventy-plugin-mathjax": "^2.0.4"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^6.0.4",
    "markdown-it-attrs": "^4.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShenRien/guyfindtheway.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ShenRien/guyfindtheway/issues"
  },
  "homepage": "https://github.com/ShenRien/guyfindtheway#readme"
}
